# Recreate the dev stack from scratch: stop & remove it, prune dangling docker
# artifacts, then rebuild and start. Inline (compose lifecycle, no script).
cmd_docker_reset() {
  _ensure_compose
  info "tearing down the dev stack..."
  (cd "$REPO_ROOT/workspace" && docker compose -f "$COMPOSE_FILE" down --remove-orphans)
  info "pruning dangling docker artifacts (containers, networks, images, build cache)..."
  docker system prune -f >/dev/null || warn "docker system prune reported an issue (continuing)"
  info "rebuilding & starting the dev stack..."
  (cd "$REPO_ROOT/workspace" && docker compose -f "$COMPOSE_FILE" up --build -d)
  ok "docker stack reset (down + prune + up --build)"
}

# Prove every MCP server works: prerequisites, wiring, then a real stdio session
# plus one read-only tool call per launcher. See scripts/mcp-check.sh.
cmd_mcp_check() {
  [ -x "$REPO_ROOT/scripts/mcp-check.sh" ] || die "scripts/mcp-check.sh not found or not executable"
  exec "$REPO_ROOT/scripts/mcp-check.sh" "$@"
}

# --- Diagnostics / agent helpers (durable scripts for recurrent checks) ---------

# List source files below the coverage threshold for a component (+ uncovered count).
cmd_coverage_gaps() {
  local comp; comp="$(_resolve_component "${1:-}")"
  local thr="${2:-95}"
  _ensure_running
  exec docker exec -w /waffle-commons "$CONTAINER" php scripts/coverage-gaps.php "$comp" "$thr"
}

# Cross-reference a PHP symbol across component src (vendor excluded, sanity-checked).
# Supply chain, independence and gates added 2026-10: thin wrappers over scripts/.
cmd_script() {
  local script="$REPO_ROOT/scripts/$1"; shift
  [ -x "$script" ] || die "scripts/${script##*/scripts/} not found or not executable"
  exec "$script" "$@"
}

cmd_xref() {
  [ -x "$REPO_ROOT/scripts/xref.sh" ] || die "scripts/xref.sh not found or not executable"
  exec "$REPO_ROOT/scripts/xref.sh" "$@"
}

# Report the umbrella + submodules with uncommitted git changes (review/commit prep).
cmd_changed() {
  [ -x "$REPO_ROOT/scripts/changed-components.sh" ] || die "scripts/changed-components.sh not found or not executable"
  exec "$REPO_ROOT/scripts/changed-components.sh" "$@"
}

# Read-only sync report: branch, dirty files, ahead/behind, gitlink match per repo.
cmd_sync_status() {
  [ -x "$REPO_ROOT/scripts/submodule-status.sh" ] || die "scripts/submodule-status.sh not found or not executable"
  exec "$REPO_ROOT/scripts/submodule-status.sh" "$@"
}

# Drift report: every component's CI workflow, Dependabot config and toolchain
# against component-template (the canonical copy).
cmd_ci_check() {
  [ -x "$REPO_ROOT/scripts/ci-check.sh" ] || die "scripts/ci-check.sh not found or not executable"
  exec "$REPO_ROOT/scripts/ci-check.sh" "$@"
}

# Boot a template app's kernel without HTTP (runs its Boot/Smoke test).
cmd_boot_smoke() {
  [ -x "$REPO_ROOT/scripts/boot-smoke.sh" ] || die "scripts/boot-smoke.sh not found or not executable"
  exec "$REPO_ROOT/scripts/boot-smoke.sh" "$@"
}

# Summarize a Workflow / background-agent JSON output file.
cmd_wf_report() {
  command -v python3 >/dev/null 2>&1 || die "python3 is required for wf-report"
  exec python3 "$REPO_ROOT/scripts/wf-report.py" "$@"
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
main() {
  local sub="${1:-help}"; shift || true
  case "$sub" in
    init)        cmd_init        "$@" ;;
    doctor)      cmd_doctor      "$@" ;;
    ai:check)    cmd_ai_check    "$@" ;;
    up)          cmd_up          "$@" ;;
    build)       cmd_build       "$@" ;;
    down)        cmd_down        "$@" ;;
    shell)       cmd_shell       "$@" ;;
    run)         cmd_run "run" "$@" ;;
    mago)        cmd_mago        "$@" ;;
    test)        cmd_test        "$@" ;;
    igor)        cmd_igor        "$@" ;;
    compare-audit) cmd_compare_audit "$@" ;;
    check:all)   cmd_check_all   "$@" ;;
    dod)         cmd_dod         "$@" ;;
    coverage)    cmd_coverage    "$@" ;;
    flake-hunt)  cmd_flake_hunt  "$@" ;;
    academy:test)   cmd_academy_test   "$@" ;;
    academy:solve)  cmd_academy_solve  "$@" ;;
    academy:reset)  cmd_academy_reset  "$@" ;;
    academy:verify) cmd_academy_verify "$@" ;;
    academy:serve)  cmd_academy_serve  "$@" ;;
    debug)       cmd_debug       "$@" ;;
    bench)       cmd_bench       "$@" ;;
    status)      cmd_status      "$@" ;;
    components)  cmd_components  "$@" ;;
    link)        cmd_link        "$@" ;;
    unlink)      cmd_unlink      "$@" ;;
    csrf-init)   cmd_csrf_init   "$@" ;;
    secret-gen)  cmd_secret_gen  "$@" ;;
    monorepo:sync) cmd_monorepo_sync "$@" ;;
    sync:contracts) cmd_sync_contracts "$@" ;;
    sync:demos)    cmd_sync_demos    "$@" ;;
    new-component) cmd_new_component "$@" ;;
    pre-release)   cmd_pre_release   "$@" ;;
    docker:reset)  cmd_docker_reset  "$@" ;;
    mcp:check)     cmd_mcp_check     "$@" ;;
    rulesets:check) cmd_rulesets check "$@" ;;
    rulesets:sync)  cmd_rulesets sync  "$@" ;;
    coverage:gaps) cmd_coverage_gaps "$@" ;;
    xref)          cmd_xref          "$@" ;;
    coverage:ratchet) cmd_script coverage-ratchet.sh "$@" ;;
    mutation)      cmd_script mutation.sh        "$@" ;;
    sbom)          cmd_script sbom.py            "$@" ;;
    images:pin)    cmd_script images-pin.py      "$@" ;;
    offline)       cmd_script offline.sh         "$@" ;;
    local-only)    cmd_script local-only.sh      "$@" ;;
    backup)        cmd_script backup-bundles.sh  "$@" ;;
    backup:schedule) cmd_script backup-schedule.sh "$@" ;;
    ai:settings)   cmd_script claude/settings-apply.py "$@" ;;
    ai:telemetry)  cmd_script claude/telemetry.py "$@" ;;
    changed)       cmd_changed       "$@" ;;
    sync:status)   cmd_sync_status   "$@" ;;
    ci:check)      cmd_ci_check      "$@" ;;
    boot-smoke)    cmd_boot_smoke    "$@" ;;
    drain-check)   cmd_script drain-check.sh     "$@" ;;
    rolling-restart) cmd_script rolling-restart.sh "$@" ;;
    wf-report)     cmd_wf_report     "$@" ;;
    audit:init)      cmd_script release-audit.py init "$@" ;;
    audit:evidence)  cmd_script release-audit.py evidence "$@" ;;
    audit:calibrate) cmd_script release-audit.py calibrate "$@" ;;
    audit:status)    cmd_script release-audit.py status "$@" ;;
    audit:claims)    cmd_script release-audit.py claims "$@" ;;
    audit:check)     cmd_script release-audit.py check "$@" ;;
    audit:sign)      cmd_script release-audit.py sign "$@" ;;
    audit:fixed)     cmd_script release-audit.py fixed "$@" ;;
    audit:profile)   cmd_script release-audit.py profile "$@" ;;
    logs)
      local logsub="${1:-}"; shift || true
      case "$logsub" in
        clear) cmd_logs_clear "$@" ;;
        ""   ) die "usage: wfl logs clear" ;;
        *    ) die "unknown 'logs' subcommand: $logsub" ;;
      esac
      ;;
    cache)
      local cachesub="${1:-}"; shift || true
      case "$cachesub" in
        clear) cmd_cache_clear "$@" ;;
        ""   ) die "usage: wfl cache clear [component]" ;;
        *    ) die "unknown 'cache' subcommand: $cachesub" ;;
      esac
      ;;
    help|-h|--help) cmd_help ;;
    *) die "unknown command: '$sub' (try: wfl help)" ;;
  esac
}

main "$@"
