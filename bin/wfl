#!/usr/bin/env bash
# ============================================================================
# wfl — Waffle Local Developer CLI
# Host-side wrapper around docker / compose / mago / phpunit for waffle-commons.
# Phase 1 of the DevOps roadmap. Submodule model: Option α (no subsplit).
# ============================================================================

set -euo pipefail

# ---------------------------------------------------------------------------
# Self-location (symlink-safe; works when invoked via ~/.local/bin/wfl)
# ---------------------------------------------------------------------------
_resolve_self() {
  local src="$1" dir
  while [ -L "$src" ]; do
    dir="$(cd -P -- "$(dirname -- "$src")" && pwd)"
    src="$(readlink -- "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  printf '%s\n' "$src"
}

SCRIPT_PATH="$(_resolve_self "${BASH_SOURCE[0]}")"
BIN_DIR="$(cd -P -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
REPO_ROOT="$(cd -P -- "$BIN_DIR/.." && pwd)"

COMPOSE_FILE="$REPO_ROOT/workspace/docker-compose.yml"
COMPOSE_SVC="waffle"
CONTAINER="waffle-dev"
CONTAINER_LEGACY="legacy-backend"
CONTAINER_REDIS="waffle-redis"
PHP_INI_DIR="$REPO_ROOT/workspace/docker/php"
ACTIVE_INI="$PHP_INI_DIR/mode-active.ini"
GITMODULES="$REPO_ROOT/.gitmodules"

# ---------------------------------------------------------------------------
# Pretty output
# ---------------------------------------------------------------------------
if [ -t 1 ]; then
  C_RED=$'\033[0;31m'; C_GRN=$'\033[0;32m'; C_YEL=$'\033[0;33m'
  C_CYA=$'\033[0;36m'; C_DIM=$'\033[2m';   C_RST=$'\033[0m'
else
  C_RED=""; C_GRN=""; C_YEL=""; C_CYA=""; C_DIM=""; C_RST=""
fi

info() { printf '%s→ %s%s\n' "$C_CYA" "$*" "$C_RST"; }
ok()   { printf '%s✓ %s%s\n' "$C_GRN" "$*" "$C_RST"; }
warn() { printf '%s! %s%s\n' "$C_YEL" "$*" "$C_RST" >&2; }
die()  { printf '%s✗ %s%s\n' "$C_RED" "$*" "$C_RST" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Guards
# ---------------------------------------------------------------------------
_ensure_compose() {
  [ -f "$COMPOSE_FILE" ] || die "compose file missing: $COMPOSE_FILE (did 'wfl init' run? is the 'workspace' submodule checked out?)"
}

_container_state() {
  docker inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null || printf 'absent'
}

_legacy_state() {
  docker inspect -f '{{.State.Status}}' "$CONTAINER_LEGACY" 2>/dev/null || printf 'absent'
}

_redis_state() {
  docker inspect -f '{{.State.Status}}' "$CONTAINER_REDIS" 2>/dev/null || printf 'absent'
}

_ensure_running() {
  local s; s="$(_container_state)"
  [ "$s" = "running" ] || die "container '$CONTAINER' not running (state: $s). Try: wfl up"
}

# ---------------------------------------------------------------------------
# Submodule / component resolution
# ---------------------------------------------------------------------------
_list_components() {
  [ -f "$GITMODULES" ] || die ".gitmodules not found at $GITMODULES"
  awk '/^[[:space:]]*path[[:space:]]*=/ {
         sub(/^[[:space:]]*path[[:space:]]*=[[:space:]]*/, "");
         print
       }' "$GITMODULES"
}

_is_component() {
  local needle="$1" p
  while IFS= read -r p; do
    [ "$p" = "$needle" ] && return 0
  done < <(_list_components)
  return 1
}

# Resolve component name from optional arg, falling back to cwd inference.
# Usage: comp="$(_resolve_component "${1:-}")"
_resolve_component() {
  local arg="${1:-}"
  if [ -n "$arg" ]; then
    _is_component "$arg" || die "unknown component: '$arg' (see: wfl components)"
    printf '%s\n' "$arg"
    return 0
  fi

  local cwd; cwd="$(pwd -P)"
  case "$cwd" in
    "$REPO_ROOT"|"$REPO_ROOT"/*) : ;;
    *) die "not inside the umbrella ($REPO_ROOT). Pass a component name explicitly." ;;
  esac

  local rel="${cwd#"$REPO_ROOT"}"
  rel="${rel#/}"
  [ -n "$rel" ] || die "at umbrella root; specify a component (e.g. 'wfl mago contracts')"

  local first="${rel%%/*}"
  _is_component "$first" || die "current dir is not inside a known component ('$first'); pass one explicitly"
  printf '%s\n' "$first"
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------
cmd_help() {
  cat <<EOF
${C_CYA}wfl${C_RST} — Waffle Local Developer CLI

${C_DIM}USAGE${C_RST}
  wfl <command> [args]

${C_DIM}LIFECYCLE${C_RST}
  init                  init submodules, boot docker, install hooks, symlink wfl into ~/.local/bin
  up [args...]          docker compose up -d (extra args passed through)
  down [args...]        docker compose down (extra args passed through)
  status                show active PHP profile and container state

${C_DIM}EXECUTION${C_RST}
  shell [comp]          open a bash shell inside the container (optionally cd into a component)
  run [comp] <cmd...>   run an arbitrary command inside a component or monorepo root
  mago [comp]           run 'composer mago' for a component (defaults to cwd)
  test [comp] [--filter=PAT]  run 'composer tests' for a component (--filter passes through to phpunit)
  igor [args...]        run the Igor memory-leak/state audit across all components (igor.sh)
  compare-audit [comp...]  SEC-03 gate: ban naive === / !== on secret/token/hmac sites (hash_equals)
  check:all [--with-tests]  parallel 'composer mago' across all components (add --with-tests for PHPUnit)
  dod <comp> [--compare-audit]  full Definition of Done (mago 0 + tests + coverage ≥95 + igor 0 KO)
  coverage <comp>       print line-coverage % from clover.xml (parses var/data/phpunit-coverage)
  flake-hunt <comp> [N=20] [--filter=PAT]  loop phpunit N× to surface flaky tests

${C_DIM}DIAGNOSTICS / AGENT HELPERS${C_RST}
  coverage:gaps <comp> [thr=95]  list source files below the coverage threshold (+ uncovered count)
  xref <Symbol> [--tests]  find references to a PHP symbol across component src (vendor excluded, sanity-checked)
  changed               list the umbrella + submodules with uncommitted git changes (review/commit prep)
  boot-smoke <app>      boot a template app's kernel without HTTP (runs its Boot/Smoke test)
  wf-report <file>      summarize a workflow/agent JSON output file (per-item findings/created/updated)

${C_DIM}ACADEMY${C_RST}
  academy:test [--lab=N_MM]   run the labs TDD suite + render the progress card (academy/labs, in container)
  academy:solve [--lab=N_MM]  load the reference solution(s) into labs/src (answer key)
  academy:reset               clear loaded solutions from labs/src (back to a blank slate)
  academy:verify              prove the reference solutions green (solve → mago → phpunit → unsolve)
  academy:serve [:PORT]       serve the sandbox playground via the FrankenPHP worker (default :8000)

${C_DIM}PHP PROFILE${C_RST}
  debug                 activate 🐛 debug profile (xdebug on, JIT off) and restart the container
  bench                 activate 🚀 bench profile (xdebug off, JIT on)  and restart the container

${C_DIM}MAINTENANCE${C_RST}
  logs clear            truncate /tmp/xdebug.log and /var/log/caddy/*.log
  cache clear [comp]    clear the PSR-16 framework cache (var/cache/psr16) for a component
  components            list known submodule components
  help                  show this help

${C_DIM}DEVELOPMENT${C_RST}
  link <consumer> <provider>   link a local provider component into a consumer composer.json
  unlink <consumer> <provider>  unlink a local provider component from a consumer composer.json
  csrf-init [token-id]          generate matching WAFFLE_SID & CSRF token for testing (defaults to '_default')
  secret-gen                    generate a fresh 32-byte cryptographically secure application secret
  monorepo:sync [--fix]         report (or with --fix, align) waffle-commons/* version constraints across components
  sync:contracts [comp|--all]   mirror fresh contracts/src into a consumer's vendored copy (skew fix)
  sync:demos [workspace|skeleton|--all]  refresh template apps' vendored framework src + dump-autoload
  new-component <PascalName> <git-url>  scaffold a new submodule from component-template, then run dod
  pre-release [comp|--all]      release-readiness: dod + version stamp (0.1.0-betaN) + CHANGELOG entry
  docker:reset                  recreate the dev stack: compose down + prune + up --build
  mcp:check                     verify MCP prereqs (npx/docker/postgres/mongo/redis/GitHub token)

${C_DIM}ENV${C_RST}
  Containers : $CONTAINER, $CONTAINER_LEGACY, $CONTAINER_REDIS
  Compose    : $COMPOSE_FILE
  Repo root  : $REPO_ROOT
EOF
}

cmd_init() {
  info "initializing submodules..."
  (cd "$REPO_ROOT" && git submodule update --init --recursive)
  ok "submodules ready"

  _ensure_compose
  info "booting docker stack..."
  (cd "$REPO_ROOT/workspace" && docker compose -f "$COMPOSE_FILE" up --build -d)
  ok "docker stack up"

  if [ -x "$REPO_ROOT/scripts/install-git-hooks.sh" ]; then
    info "installing git hooks..."
    (cd "$REPO_ROOT" && ./scripts/install-git-hooks.sh)
  else
    warn "scripts/install-git-hooks.sh not found or not executable; skipping hooks"
  fi

  local target="$HOME/.local/bin/wfl"
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$BIN_DIR/wfl" "$target"
  ok "symlinked $target → $BIN_DIR/wfl"

  case ":$PATH:" in
    *":$HOME/.local/bin:"*) : ;;
    *) warn "\$HOME/.local/bin is not on \$PATH — add it to your shell rc to use 'wfl' globally" ;;
  esac
}

cmd_up()   { _ensure_compose; (cd "$REPO_ROOT/workspace" && docker compose -f "$COMPOSE_FILE" up -d "$@"); }
cmd_down() { _ensure_compose; (cd "$REPO_ROOT/workspace" && docker compose -f "$COMPOSE_FILE" down    "$@"); }

cmd_shell() {
  _ensure_running
  local arg="${1:-}"
  if [ -n "$arg" ]; then
    local comp; comp="$(_resolve_component "$arg")"
    exec docker exec -it -w "/waffle-commons/$comp" "$CONTAINER" bash
  fi
  exec docker exec -it -w "/waffle-commons" "$CONTAINER" bash
}

cmd_run() {
  _ensure_running
  local UMBRELLA_DIR="${REPO_ROOT}"
  local target_dir

  # Vérifier si le premier argument après run ($2) correspond à un dossier existant à la racine du monorepo (via ${UMBRELLA_DIR}/$2).
  if [ -n "${2:-}" ] && [ -d "${UMBRELLA_DIR}/${2}" ]; then
    # Si le dossier existe ET que $2 n'est pas vide :
    # Définir le dossier cible sur /waffle-commons/$2.
    target_dir="/waffle-commons/$2"
    # shift 2 pour retirer le mot-clé 'run' et le dossier du composant de la liste des arguments.
    shift 2
  else
    # Si le dossier n'existe pas :
    # Définir le dossier cible sur /waffle-commons (la racine du monorepo).
    target_dir="/waffle-commons"
    # shift 1 pour retirer uniquement le mot-clé 'run'.
    shift 1
  fi

  # S'assurer qu'une commande a bien été passée (nombre d'arguments restant supérieur à 0),
  # sinon afficher un message d'erreur clair en français et quitter avec le code 1.
  if [ $# -eq 0 ]; then
    die "[ERREUR] Aucune commande n'a été spécifiée."
  fi

  # Exécuter les arguments restants dynamiquement dans le conteneur.
  exec docker exec -it -w "${target_dir}" "$CONTAINER" "$@"
}

cmd_mago() {
  local comp; comp="$(_resolve_component "${1:-}")"
  _ensure_running
  exec docker exec -it -w "/waffle-commons/$comp" "$CONTAINER" composer mago
}

cmd_test() {
  # Optional --filter=PAT (or --filter PAT) is forwarded to PHPUnit via Composer's
  # post-script arg pass-through ('composer tests -- --filter PAT'). A leading
  # positional component name is still honored; the filter may appear anywhere.
  local comp_arg="" filter=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --filter=*) filter="${1#--filter=}"; shift ;;
      --filter)   shift; if [ $# -gt 0 ]; then filter="$1"; shift; fi ;;
      *)          [ -z "$comp_arg" ] && comp_arg="$1"; shift ;;
    esac
  done

  local comp; comp="$(_resolve_component "$comp_arg")"
  _ensure_running
  if [ -n "$filter" ]; then
    exec docker exec -it -w "/waffle-commons/$comp" "$CONTAINER" composer tests -- --filter "$filter"
  fi
  exec docker exec -it -w "/waffle-commons/$comp" "$CONTAINER" composer tests
}

cmd_igor() {
  # Igor memory-leak / shared-state audit across every component.
  # igor.sh self-locates, dynamically scans for the igor-php dependency, and
  # runs its own docker/local mode detection + container preflight, so all args
  # (e.g. --silent, --local, -c <comp>, -- <igor args>) are forwarded verbatim.
  [ -x "$REPO_ROOT/igor.sh" ] || die "igor.sh not found or not executable at $REPO_ROOT/igor.sh"
  exec "$REPO_ROOT/igor.sh" "$@"
}

cmd_compare_audit() {
  # SEC-03 timing-safe comparison gate. Thin wrapper around the shared runner
  # scripts/sec03-compare-audit.php (which reuses the unit-tested
  # SensitiveComparisonScanner) to ban naive === / !== between two runtime
  # secrets (token, hmac, signature, key, …) that must use hash_equals().
  # No args ⇒ sweep the security-sensitive components; otherwise the named ones.
  [ -f "$REPO_ROOT/scripts/sec03-compare-audit.php" ] \
    || die "scripts/sec03-compare-audit.php not found at $REPO_ROOT/scripts/"
  _ensure_running
  exec docker exec -w /waffle-commons "$CONTAINER" \
    php scripts/sec03-compare-audit.php "$@"
}

cmd_academy_test() {
  # Waffle Academy — lance la suite PHPUnit des labs dans le conteneur de dev.
  # Composant isolé : academy/labs (dépendances résolues par path repos symlink).
  # Option : --lab=NOM (ou --lab NOM) -> transmis à PHPUnit via --filter NOM.
  local lab=""
  local -a pu_args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --lab=*) lab="${1#--lab=}"; shift ;;
      --lab)   shift; if [ $# -gt 0 ]; then lab="$1"; shift; fi ;;
      *)       pu_args+=("$1"); shift ;;
    esac
  done

  local labs_host="$REPO_ROOT/academy/labs"
  [ -d "$labs_host" ] || die "academy/labs introuvable ($labs_host). Le sous-module 'academy' est-il initialisé ? (essayez: wfl init)"

  # Préflight : les dépendances Composer doivent être installées dans academy/labs.
  if [ ! -d "$labs_host/vendor" ]; then
    warn "Les dépendances de academy/labs ne sont pas installées."
    info "Lancez : docker exec -it -w /waffle-commons/academy/labs $CONTAINER composer install"
    die "academy/labs/vendor manquant — installez les dépendances d'abord"
  fi

  _ensure_running

  if [ -n "$lab" ]; then
    pu_args+=(--filter "$lab")
  fi

  local junit="var/cache/phpunit/junit.xml"
  local pu_code=0
  # Allouer un TTY seulement s'il y en a un (sinon CI / pipes échouent ; PHPUnit
  # force déjà les couleurs via phpunit.xml).
  local tty=""
  [ -t 1 ] && tty="-it"
  info "exécution de la suite Waffle Academy (labs)${lab:+ — filtre: $lab}..."
  # PHPUnit dans le conteneur : sortie live + rapport JUnit pour la carte (ACAD-02).
  if [ "${#pu_args[@]}" -gt 0 ]; then
    docker exec $tty -w "/waffle-commons/academy/labs" "$CONTAINER" \
      vendor/bin/phpunit --log-junit "$junit" "${pu_args[@]}" || pu_code=$?
  else
    docker exec $tty -w "/waffle-commons/academy/labs" "$CONTAINER" \
      vendor/bin/phpunit --log-junit "$junit" || pu_code=$?
  fi

  # Gate statique (lecture seule) → ligne « propreté du code » de la carte.
  local mago_status="ok"
  docker exec -w "/waffle-commons/academy/labs" "$CONTAINER" sh -c \
    'vendor/bin/mago fmt --check >/dev/null 2>&1 && vendor/bin/mago lint >/dev/null 2>&1 && vendor/bin/mago analyze >/dev/null 2>&1 && vendor/bin/mago guard --perimeter >/dev/null 2>&1' \
    || mago_status="ko"

  # Carte de progression terminale (ACAD-02).
  docker exec -w "/waffle-commons" "$CONTAINER" \
    php scripts/academy-card.php \
    "/waffle-commons/academy/labs/$junit" "/waffle-commons/academy/labs" "$mago_status" "$lab" \
    || true

  return "$pu_code"
}

cmd_academy_solve() {
  # Charge le(s) corrigé(s) (answer key) depuis labs/solutions/ vers labs/src/.
  # Option : --lab=N_MM pour un seul lab (ex. 1_01 → solutions/Lesson0101).
  local lab=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --lab=*) lab="${1#--lab=}"; shift ;;
      --lab)   shift; if [ $# -gt 0 ]; then lab="$1"; shift; fi ;;
      *)       shift ;;
    esac
  done
  _ensure_running
  if [ -n "$lab" ]; then
    local dir="Lesson0${lab//_/}"
    info "chargement du corrigé $lab → src/$dir ..."
    docker exec -w "/waffle-commons/academy/labs" "$CONTAINER" sh -c \
      "cp -R solutions/$dir src/ && composer dump-autoload -q" \
      || die "corrigé introuvable pour le lab '$lab' (solutions/$dir)"
    ok "corrigé $lab chargé — vérifiez : wfl academy:test --lab=$lab"
  else
    info "chargement de TOUS les corrigés dans src/ ..."
    docker exec -w "/waffle-commons/academy/labs" "$CONTAINER" composer solve
    ok "tous les corrigés chargés dans src/"
  fi
}

cmd_academy_reset() {
  # Réinitialise labs/src/ : supprime les implémentations chargées (retour vierge).
  _ensure_running
  info "réinitialisation de labs/src/ (suppression des implémentations) ..."
  docker exec -w "/waffle-commons/academy/labs" "$CONTAINER" composer unsolve
  ok "labs/src/ réinitialisé (seul .gitkeep subsiste)"
}

cmd_academy_verify() {
  # Preuve « corrigé au vert » : solve → mago → guard → phpunit → unsolve.
  _ensure_running
  info "vérification du corrigé (solve → mago → phpunit → unsolve) ..."
  exec docker exec -it -w "/waffle-commons/academy/labs" "$CONTAINER" composer verify
}

cmd_academy_serve() {
  # Sert l'applicatif sandbox via le worker FrankenPHP, à l'intérieur du conteneur.
  # Port d'écoute optionnel (défaut :8000). Non publié vers l'hôte : accès depuis
  # `wfl shell` (curl) ou en publiant le port côté docker-compose.
  local listen="${1:-:8000}"
  local sandbox_host="$REPO_ROOT/academy/sandbox"
  [ -d "$sandbox_host" ] || die "academy/sandbox introuvable ($sandbox_host)."
  if [ ! -d "$sandbox_host/vendor" ]; then
    warn "Les dépendances de academy/sandbox ne sont pas installées."
    info "Lancez : docker exec -it -w /waffle-commons/academy/sandbox $CONTAINER composer install"
    die "academy/sandbox/vendor manquant — installez les dépendances d'abord"
  fi
  _ensure_running
  info "worker FrankenPHP de la sandbox sur ${listen} (Ctrl-C pour arrêter)..."
  info "accès depuis le conteneur : wfl shell → curl http://127.0.0.1${listen}/"
  exec docker exec -it -w "/waffle-commons/academy/sandbox" "$CONTAINER" \
    frankenphp php-server --listen "$listen" --root public --worker public/index.php
}

_swap_profile() {
  local target="$1" label="$2"
  [ -f "$PHP_INI_DIR/$target" ] || die "profile file missing: $PHP_INI_DIR/$target"
  ln -sfn "$target" "$ACTIVE_INI"
  ok "active profile → $label ($target)"

  local s; s="$(_container_state)"
  if [ "$s" = "running" ]; then
    info "restarting $COMPOSE_SVC..."
    (cd "$REPO_ROOT/workspace" && docker compose -f "$COMPOSE_FILE" restart "$COMPOSE_SVC" >/dev/null)
    ok "container restarted"
  else
    warn "container not running (state: $s) — profile will apply on next 'wfl up'"
  fi
}

cmd_debug() { _ensure_compose; _swap_profile "mode-debug.ini" "🐛 debug"; }
cmd_bench() { _ensure_compose; _swap_profile "mode-bench.ini" "🚀 bench"; }

cmd_status() {
  local profile target
  if [ -L "$ACTIVE_INI" ]; then
    target="$(readlink "$ACTIVE_INI")"
    case "$target" in
      mode-debug.ini) profile="🐛 debug" ;;
      mode-bench.ini) profile="🚀 bench" ;;
      *)              profile="❓ unknown ($target)" ;;
    esac
  elif [ -f "$ACTIVE_INI" ]; then
    profile="❓ regular file (expected symlink): $ACTIVE_INI"
  else
    profile="✗ missing: $ACTIVE_INI"
  fi

  local container_state; container_state="$(_container_state)"
  local legacy_state; legacy_state="$(_legacy_state)"
  local redis_state; redis_state="$(_redis_state)"
  printf 'PHP profile : %s\n---\n' "$profile"
  printf 'Container   : %s (%s)\n' "$CONTAINER" "$container_state"
  printf 'Legacy      : %s (%s)\n' "$CONTAINER_LEGACY" "$legacy_state"
  printf 'Redis       : %s (%s)\n---\n' "$CONTAINER_REDIS" "$redis_state"
  printf 'Compose     : %s\n' "$COMPOSE_FILE"
  printf 'Repo root   : %s\n' "$REPO_ROOT"
}

cmd_logs_clear() {
  _ensure_running
  docker exec "$CONTAINER" sh -c '
    : > /tmp/xdebug.log 2>/dev/null || true
    for f in /var/log/caddy/*.log; do
      [ -f "$f" ] && : > "$f"
    done
  '
  ok "logs cleared"
}

cmd_cache_clear() {
  local comp; comp="$(_resolve_component "${1:-}")"
  _ensure_running
  info "clearing PSR-16 framework cache for '$comp'..."
  docker exec -w "/waffle-commons/$comp" "$CONTAINER" sh -c 'rm -rf var/cache/psr16 2>/dev/null || true'
  ok "cache cleared (var/cache/psr16)"
}

cmd_csrf_init() {
  local token_id="${1:-_default}"
  local secret=""

  # Try to read WAFFLE_CSRF_SECRET from environment or .env files
  if [ -n "${WAFFLE_CSRF_SECRET:-}" ]; then
    secret="$WAFFLE_CSRF_SECRET"
  elif [ -f "$REPO_ROOT/.env" ] && grep -q '^WAFFLE_CSRF_SECRET=' "$REPO_ROOT/.env"; then
    secret="$(grep '^WAFFLE_CSRF_SECRET=' "$REPO_ROOT/.env" | cut -d'=' -f2- || true)"
  elif [ -f "$REPO_ROOT/workspace/.env" ] && grep -q '^WAFFLE_CSRF_SECRET=' "$REPO_ROOT/workspace/.env"; then
    secret="$(grep '^WAFFLE_CSRF_SECRET=' "$REPO_ROOT/workspace/.env" | cut -d'=' -f2- || true)"
  fi

  # Run PHP execution
  local php_code
  php_code="
\$secret = getenv('WAFFLE_CSRF_SECRET');
if (!\$secret) {
    \$envFiles = [
        getenv('REPO_ROOT') . '/workspace/.env',
        getenv('REPO_ROOT') . '/.env',
        '/waffle-commons/workspace/.env',
        '/waffle-commons/.env'
    ];
    foreach (\$envFiles as \$envFile) {
        if (\$envFile && file_exists(\$envFile)) {
            \$lines = file(\$envFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
            foreach (\$lines as \$line) {
                if (str_starts_with(trim(\$line), 'WAFFLE_CSRF_SECRET=')) {
                    \$parts = explode('=', \$line, 2);
                    \$secret = trim(\$parts[1], \" \t\n\r\0\x0B'\\\"\");
                    break 2;
                }
            }
        }
    }
}

\$isGenerated = false;
if (!\$secret || strlen(\$secret) < 32) {
    \$secret = bin2hex(random_bytes(32));
    \$isGenerated = true;
}

\$rawSid = random_bytes(32);
\$sid = rtrim(strtr(base64_encode(\$rawSid), '+/', '-_'), '=');
\$tokenId = getenv('TOKEN_ID') ?: '_default';
\$nonce = random_bytes(16);
\$expiresAtTimestamp = time() + 3600;
\$timestampBytes = pack('J', \$expiresAtTimestamp);
\$hmac = hash_hmac('sha256', \$nonce . \$timestampBytes . \$tokenId . 'anon:' . \$sid, \$secret, true);
\$token = rtrim(strtr(base64_encode(\$nonce . \$timestampBytes . \$hmac), '+/', '-_'), '=');

echo 'SECRET:' . \$secret . \"\n\";
echo 'GENERATED:' . (\$isGenerated ? 'true' : 'false') . \"\n\";
echo 'SID:' . \$sid . \"\n\";
echo 'TOKEN:' . \$token . \"\n\";
echo 'ID:' . \$tokenId . \"\n\";
"

  local php_out=""
  local container_state; container_state="$(_container_state)"
  if [ "$container_state" = "running" ]; then
    php_out="$(docker exec -e REPO_ROOT="$REPO_ROOT" -e WAFFLE_CSRF_SECRET="$secret" -e TOKEN_ID="$token_id" "$CONTAINER" php -r "$php_code" 2>/dev/null || true)"
  fi

  # Fallback to local host php if docker exec is empty or not running
  if [ -z "$php_out" ]; then
    if command -v php >/dev/null 2>&1; then
      php_out="$(REPO_ROOT="$REPO_ROOT" WAFFLE_CSRF_SECRET="$secret" TOKEN_ID="$token_id" php -r "$php_code" 2>/dev/null || true)"
    fi
  fi

  if [ -z "$php_out" ]; then
    die "PHP is not available on host and container '$CONTAINER' is not running. Run 'wfl up' first."
  fi

  # Parse output variables
  local out_secret="" out_gen="" out_sid="" out_token="" out_id=""
  while IFS= read -r line; do
    case "$line" in
      SECRET:*)    out_secret="${line#SECRET:}" ;;
      GENERATED:*) out_gen="${line#GENERATED:}" ;;
      SID:*)       out_sid="${line#SID:}" ;;
      TOKEN:*)     out_token="${line#TOKEN:}" ;;
      ID:*)        out_id="${line#ID:}" ;;
    esac
  done <<< "$php_out"

  # Display beautifully
  info "Generating CSRF test credentials..."
  echo ""
  if [ "$out_gen" = "true" ]; then
    warn "WAFFLE_CSRF_SECRET was not found in environment or .env file."
    info "Generated a fresh secret for this session (add this to your .env file):"
    printf "  %s%s%s\n\n" "$C_YEL" "$out_secret" "$C_RST"
  else
    ok "Using existing WAFFLE_CSRF_SECRET loaded from environment/.env"
    printf "  %s%s%s\n\n" "$C_DIM" "$out_secret" "$C_RST"
  fi

  ok "CSRF credentials generated successfully (Token ID: '$out_id')"
  echo "------------------------------------------------------------"
  printf "%sWAFFLE_SID Cookie Value (valid for 30 days):%s\n" "$C_CYA" "$C_RST"
  printf "  %s%s%s\n\n" "$C_GRN" "$out_sid" "$C_RST"

  printf "%sX-CSRF-Token / _csrf_token value (valid for 1 hour):%s\n" "$C_CYA" "$C_RST"
  printf "  %s%s%s\n" "$C_GRN" "$out_token" "$C_RST"
  echo "------------------------------------------------------------"
  echo ""
  info "To use these in Postman:"
  echo "  1. Add a cookie named 'WAFFLE_SID' with value '$out_sid' for your local domain."
  echo "  2. Add a request header 'X-CSRF-Token' with value '$out_token'."
}

cmd_secret_gen() {
  local secret=""

  if command -v php >/dev/null 2>&1; then
    secret="$(php -r 'echo bin2hex(random_bytes(32));' || true)"
  elif command -v openssl >/dev/null 2>&1; then
    secret="$(openssl rand -hex 32 || true)"
  elif [ "$(_container_state)" = "running" ]; then
    secret="$(docker exec "$CONTAINER" php -r 'echo bin2hex(random_bytes(32));' || true)"
  fi

  if [ -z "$secret" ]; then
    die "Neither PHP, openssl, nor the running container '$CONTAINER' could be used to generate a secure secret."
  fi

  info "Generating a fresh 32-byte (256-bit) cryptographically secure application secret..."
  echo ""
  ok "Generated successfully!"
  echo "------------------------------------------------------------"
  printf "  %s%s%s\n" "$C_GRN" "$secret" "$C_RST"
  echo "------------------------------------------------------------"
  echo ""
  info "To use this in your application, add or replace it in your .env file:"
  printf "  %sAPP_SECRET=%s%s\n" "$C_YEL" "$secret" "$C_RST"
}

cmd_components() { _list_components; }

cmd_link() {
  local consumer="${1:-}"
  local provider="${2:-}"
  if [ -z "$consumer" ] || [ -z "$provider" ]; then
    die "Usage: wfl link <consumer> <provider>"
  fi

  local UMBRELLA_DIR="${REPO_ROOT}"
  local consumer_dir="${UMBRELLA_DIR}/${consumer}"
  local provider_dir="${UMBRELLA_DIR}/${provider}"

  # Validate that directories and composer.json exist
  [ -d "$consumer_dir" ] || die "[ERROR] Component '$consumer' not found."
  [ -d "$provider_dir" ] || die "[ERROR] Component '$provider' not found."
  [ -f "$consumer_dir/composer.json" ] || die "[ERROR] composer.json for component '$consumer' not found."
  [ -f "$provider_dir/composer.json" ] || die "[ERROR] composer.json for component '$provider' not found."

  _ensure_running

  info "Local linking: modifying $consumer/composer.json to point to $provider..."

  # Zero-Magic inline PHP execution inside the Docker container
  docker exec -w "/waffle-commons/$consumer" -e PROVIDER="$provider" "$CONTAINER" php -r '
    $provider = getenv("PROVIDER");
    $file = "composer.json";
    if (!file_exists($file)) {
        fwrite(STDERR, "[ERROR] File $file not found.\n");
        exit(1);
    }
    $data = json_decode(file_get_contents($file), true);
    if (json_last_error() !== JSON_ERROR_NONE) {
        fwrite(STDERR, "[ERROR] Failed to decode composer.json.\n");
        exit(1);
    }
    if (!isset($data["repositories"])) {
        $data["repositories"] = [];
    } else if (!is_array($data["repositories"])) {
        $data["repositories"] = array_values((array)$data["repositories"]);
    }
    $url = "../" . $provider;
    $exists = false;
    foreach ($data["repositories"] as $repo) {
        if (isset($repo["type"]) && $repo["type"] === "path" && isset($repo["url"]) && $repo["url"] === $url) {
            $exists = true;
            break;
        }
    }
    if (!$exists) {
        array_unshift($data["repositories"], [
            "type" => "path",
            "url" => $url,
            "canonical" => false,
            "options" => [
                "symlink" => false
            ]
        ]);
    }
    file_put_contents($file, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");
  '

  info "Updating Composer packages in container..."
  docker exec -w "/waffle-commons/$consumer" "$CONTAINER" composer update "waffle-commons/$provider" --no-interaction

  ok "[SUCCESS] Component \"$provider\" linked to \"$consumer\" successfully."
}

cmd_unlink() {
  local consumer="${1:-}"
  local provider="${2:-}"
  if [ -z "$consumer" ] || [ -z "$provider" ]; then
    die "Usage: wfl unlink <consumer> <provider>"
  fi

  local UMBRELLA_DIR="${REPO_ROOT}"
  local consumer_dir="${UMBRELLA_DIR}/${consumer}"

  # Validate directories
  [ -d "$consumer_dir" ] || die "[ERROR] Component '$consumer' not found."
  [ -f "$consumer_dir/composer.json" ] || die "[ERROR] composer.json for component '$consumer' not found."

  _ensure_running

  info "Local unlinking: restoring $consumer/composer.json for $provider..."

  # Zero-Magic inline PHP execution to revert modifications
  docker exec -w "/waffle-commons/$consumer" -e PROVIDER="$provider" "$CONTAINER" php -r '
    $provider = getenv("PROVIDER");
    $file = "composer.json";
    if (!file_exists($file)) {
        fwrite(STDERR, "[ERROR] File $file not found.\n");
        exit(1);
    }
    $data = json_decode(file_get_contents($file), true);
    if (json_last_error() !== JSON_ERROR_NONE) {
        fwrite(STDERR, "[ERROR] Failed to decode composer.json.\n");
        exit(1);
    }
    if (isset($data["repositories"]) && is_array($data["repositories"])) {
        $url = "../" . $provider;
        $newRepos = [];
        foreach ($data["repositories"] as $repo) {
            if (isset($repo["type"]) && $repo["type"] === "path" && isset($repo["url"]) && $repo["url"] === $url) {
                continue;
            }
            $newRepos[] = $repo;
        }
        if (empty($newRepos)) {
            unset($data["repositories"]);
        } else {
            $data["repositories"] = $newRepos;
        }
        file_put_contents($file, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");
    }
  '

  info "Restoring standard Composer packages in container..."
  docker exec -w "/waffle-commons/$consumer" "$CONTAINER" composer update "waffle-commons/$provider" --no-interaction

  ok "[SUCCESS] Component \"$provider\" unlinked from \"$consumer\" successfully."
}

# ---------------------------------------------------------------------------
# DX-01 — monorepo-wide tooling (internal contributors)
# ---------------------------------------------------------------------------

# Parallel static-gate sweep. Runs 'composer mago' (fmt+lint+analyze+guard) for
# every component that ships a mago script, in parallel, and prints a green/red
# summary. PHPUnit is intentionally NOT in the fast budget — add --with-tests to
# also run 'composer tests' per component.
cmd_check_all() {
  _ensure_running

  local with_tests=0 a
  for a in "$@"; do
    case "$a" in
      --with-tests) with_tests=1 ;;
      *) die "unknown option for check:all: '$a' (use --with-tests)" ;;
    esac
  done

  local -a comps=(); local p
  while IFS= read -r p; do
    # component-template ships a placeholder package name that Composer rejects
    # before any script runs — it is a scaffold, not a gateable package.
    case "$p" in component-template) continue ;; esac
    [ -f "$REPO_ROOT/$p/composer.json" ] || continue
    grep -q '"mago"' "$REPO_ROOT/$p/composer.json" || continue
    comps+=("$p")
  done < <(_list_components)
  [ "${#comps[@]}" -gt 0 ] || die "no mago-enabled components found"

  local tmp; tmp="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" EXIT

  local failures=0 start; start="$SECONDS"
  # Bounded parallelism: a full fan-out runs ~20 vendor-walking analyzers at once
  # and exhausts file descriptors on the macOS/Docker share. Tune with WFL_CHECK_JOBS.
  local max_jobs="${WFL_CHECK_JOBS:-4}"

  _sweep() { # $1=composer-script  $2=label
    local script="$1" label="$2" c
    info "check:all — 'composer $script' across ${#comps[@]} components (≤${max_jobs} parallel)…"
    for c in "${comps[@]}"; do
      while [ "$(jobs -rp | wc -l | tr -d ' ')" -ge "$max_jobs" ]; do sleep 0.2; done
      ( if docker exec -w "/waffle-commons/$c" "$CONTAINER" composer "$script" >"$tmp/$c.$script" 2>&1
        then printf 'PASS' >"$tmp/$c.$script.ok"; else printf 'FAIL' >"$tmp/$c.$script.ok"; fi ) &
    done
    wait
    for c in "${comps[@]}"; do
      if [ "$(cat "$tmp/$c.$script.ok" 2>/dev/null)" = PASS ]; then
        ok "$label $c"
      else
        failures=$((failures + 1)); warn "$label $c — FAILED"
        sed 's/^/      /' "$tmp/$c.$script" >&2
      fi
    done
  }

  _sweep mago "mago "
  [ "$with_tests" = 1 ] && _sweep tests "tests"

  local elapsed=$((SECONDS - start))
  if [ "$failures" -eq 0 ]; then
    ok "check:all GREEN — ${#comps[@]} components in ${elapsed}s"
  else
    die "check:all RED — $failures failure(s) in ${elapsed}s"
  fi
}

# Report (and with --fix, align) the version constraints each component declares
# for its waffle-commons/* siblings. The monorepo convention is "self.version";
# any sibling constraint that drifts from it is flagged. Read-only by default.
cmd_monorepo_sync() {
  local convention="self.version" do_fix=0 a
  for a in "$@"; do
    case "$a" in
      --fix) do_fix=1 ;;
      *) die "unknown option for monorepo:sync: '$a' (use --fix)" ;;
    esac
  done

  local p drift=0 fixed=0
  while IFS= read -r p; do
    # The template apps + docs are consumers, not released framework packages —
    # they legitimately pin dev/path constraints, so they are out of sync scope.
    case "$p" in skeleton|workspace|academy|documentation) continue ;; esac
    local cj="$REPO_ROOT/$p/composer.json"
    [ -f "$cj" ] || continue
    local line pkg constraint
    while IFS= read -r line; do
      pkg="$(printf '%s' "$line" | sed -E 's/.*"(waffle-commons\/[a-z0-9-]+)".*/\1/')"
      constraint="$(printf '%s' "$line" | sed -E 's/.*"waffle-commons\/[a-z0-9-]+"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/')"
      [ "$constraint" = "$convention" ] && continue
      drift=$((drift + 1))
      warn "$p → $pkg : \"$constraint\" (expected \"$convention\")"
      if [ "$do_fix" = 1 ]; then
        sed -i.bak -E "s#(\"$pkg\"[[:space:]]*:[[:space:]]*\")[^\"]*(\")#\1${convention}\2#" "$cj" \
          && rm -f "$cj.bak" && fixed=$((fixed + 1)) && ok "  aligned $p → $pkg"
      fi
    done < <(grep -E '"waffle-commons/[a-z0-9-]+"[[:space:]]*:' "$cj")
  done < <(_list_components)

  if [ "$drift" -eq 0 ]; then
    ok "monorepo:sync — all sibling constraints already use \"$convention\""
  elif [ "$do_fix" = 1 ]; then
    ok "monorepo:sync — aligned $fixed/$drift constraint(s) to \"$convention\""
  else
    warn "monorepo:sync — $drift constraint(s) drift from \"$convention\"; re-run with --fix to align"
  fi
}

# ---------------------------------------------------------------------------
# Beta5 DX — quality gates, skew fixes, scaffolding & MCP prereqs
# These are thin host-side wrappers around the runners in scripts/ (single
# source of truth: scripts/list-components.sh ← .gitmodules). docker:reset is
# the one inline command (compose lifecycle, no script needed).
# ---------------------------------------------------------------------------

# Full Definition of Done for one component (mago 0 + tests + coverage ≥95 +
# igor 0 KO + optional SEC-03 compare-audit). See scripts/dod.sh.
cmd_dod() {
  [ -x "$REPO_ROOT/scripts/dod.sh" ] || die "scripts/dod.sh not found or not executable"
  exec "$REPO_ROOT/scripts/dod.sh" "$@"
}

# Print a component's line-coverage % parsed from its clover.xml (replaces the
# brittle HTML aria-valuenow scraping). See scripts/coverage-percent.php.
cmd_coverage() {
  local comp; comp="$(_resolve_component "${1:-}")"
  _ensure_running
  exec docker exec -w /waffle-commons "$CONTAINER" php scripts/coverage-percent.php "$comp"
}

# Loop a component's PHPUnit suite N times to surface flaky tests. See
