{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@slkiser/opencode-quota",
    "opencode-fast-apply",
    "openslimedit@latest",
    "caveman-opencode-plugin",
    "@tarquinen/opencode-dcp@latest"
  ],
  "provider": {
    "anthropic": {
      "api": "https://api.anthropic.com/v1"
    }
  },
  "mode": {
    "plan": {
      "model": "opencode/nemotron-3-super-free"
    },
    "build": {
      "model": "opencode/nemotron-3-super-free"
    }
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "bash",
        "scripts/mcp/filesystem.sh"
      ],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": [
        "bash",
        "scripts/mcp/postgres.sh"
      ],
      "enabled": true
    },
    "mongo": {
      "type": "local",
      "command": [
        "bash",
        "scripts/mcp/mongo.sh"
      ],
      "enabled": true
    },
    "redis": {
      "type": "local",
      "command": [
        "bash",
        "scripts/mcp/redis.sh"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "bash",
        "scripts/mcp/github.sh"
      ],
      "enabled": true
    }
  }
}
